{
  "shared": {
    "hostWorkspaceRoot": "/mnt/nas_ssd/quick_access_for_pc/hermes/git-workspaces",
    "hermesWorkspaceRoot": "/workspace/git-workspaces",
    "defaultWorkerWorkspaceRoot": "/workspaces",
    "managedLabel": "ai.runner.managed",
    "managedLabelValue": "true"
  },
  "profiles": {
    "piwotworki": {
      "hostRepoRoot": "/mnt/nas_ssd/quick_access_for_pc/hermes/piwotworki",
      "image": "piwotworki-dev:latest",
      "allowedExecutables": [
        "npm",
        "npx",
        "node",
        "git",
	"jest"
      ],
      "mounts": [
        {
          "sourceFromShared": "hostWorkspaceRoot",
          "target": "/workspace/piwotworki",
          "readOnly": false
        }
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "command": [
        "sleep",
        "infinity"
      ],
      "resources": {
        "memory": "4g",
        "cpus": 2
      }
    },
    "godot-td": {
      "hostRepoRoot": "/mnt/nas_ssd/quick_access_for_pc/hermes/poke-defense-godot",
      "image": "godot-td-dev:latest",
      "allowedExecutables": [
        "godot",
        "python3",
        "git"
      ],
      "mounts": [

	  {
	   "sourceFromShared": "hostWorkspaceRoot",
           "target": "/workspaces",
           "readOnly": false
         },
         {
		"sourceFromProfile": "hostRepoRoot",
		"target": "/workspace/poke-defense-godot",
	    	"readOnly": false
	  }
      ],
      "command": [
        "sleep",
        "infinity"
      ],
      "resources": {
        "memory": "8g",
        "cpus": 4
      }
    }
  }
}
