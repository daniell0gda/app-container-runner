{
  "shared": {
    "hostWorkspaceRoot": "/home/ferens/hermes/workspace",
    "hermesWorkspaceRoot": "/opt/workspace/git-workspaces",
    "defaultWorkerWorkspaceRoot": "/opt/workspace/git-workspaces",
    "managedLabel": "ai.runner.managed",
    "managedLabelValue": "true",
    "allowedImages": [
      "nexus.pdtec.lan:5500/linux-nodejs:lts",
      "nexus.pdtec.lan:5500/linux-nodejs:24",
      "nexus.pdtec.lan:5500/linux-nodejs-chromium:lts-snapshot-mr-79",
      "nexus.pdtec.lan:5500/linux-cypress:15-snapshot-mr-79"
    ]
  },
  "profiles": {
    "simple-ng-proj": {
      "image": "nexus.pdtec.lan:5500/linux-nodejs:lts",
      "allowedExecutables": [
        "npm",
        "npx",
        "node",
        "git"
      ],
      "mounts": [
        {
          "sourceFromShared": "hostWorkspaceRoot",
          "target": "/opt/workspace",
          "readOnly": false
        }
      ],
      "env": {
        "NODE_ENV": "development",
        "npm_config_cache": "/opt/workspace/.npm-cache"
      },
      "command": [
        "sleep",
        "infinity"
      ],
      "entrypoint": [],
      "resources": {
        "memory": "10g",
        "cpus": 2
      }
    }
  }
}
