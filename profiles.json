{
  "shared": {
    "hostWorkspaceRoot": "/mnt/p/hermes/agent/workspace/git-workspaces",
    "hermesWorkspaceRoot": "/opt/workspace/git-workspaces",
    "defaultWorkerWorkspaceRoot": "/workspaces",
    "managedLabel": "ai.runner.managed",
    "managedLabelValue": "true"
  },
  "profiles": {
    "simple-ng-proj": {
      "image": "nexus.pdtec.lan:5500/linux-nodejs:lts",
      "allowedExecutables": [
        "npm",
        "npx",
        "node",
        "git"
      ],
      "mounts": [
        {
          "sourceFromShared": "hostWorkspaceRoot",
          "target": "/workspaces",
          "readOnly": false
        }
      ],
      "env": {
        "NODE_ENV": "development"
      },
      "command": [
        "sleep",
        "infinity"
      ],
      "resources": {
        "memory": "4g",
        "cpus": 2
      }
    }
  }
}
