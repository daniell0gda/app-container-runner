{
  "aliases": [
    "godot-td"
  ],
  "image": "nexus.pdtec.lan:5500/linux-nodejs:lts",
  "allowedExecutables": [
    "godot",
    "git"
  ],
  "mounts": [
    {
      "sourceFromShared": "hostWorkspaceRoot",
      "target": "/workspaces",
      "readOnly": false
    }
  ],
  "env": {
    "NODE_ENV": "development"
  },
  "command": [
    "sleep",
    "infinity"
  ],
  "resources": {
    "memory": "4g",
    "cpus": 2
  },
  "_comment_image": "Fallback when request omits image. Per-issue SoT is <worktree>/.hermes/hermes_config.yaml (else .agents) image."
}
